
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasUserProfile() && currentUser().role == 'super_admin';
    }

    function hasActiveStatus(userData) {
      return !('accountStatus' in userData) || userData.accountStatus == 'active';
    }

    function hasValidPlan(userData) {
      return !('planExpiryDate' in userData) ||
             userData.planExpiryDate == null ||
             userData.planExpiryDate >= request.time;
    }

    function isActiveTransporter() {
      return hasUserProfile() &&
             currentUser().role == 'transporter' &&
             hasActiveStatus(currentUser()) &&
             hasValidPlan(currentUser());
    }

    function ownsCompany(data) {
      return data.companyId == request.auth.uid ||
             data.userId == request.auth.uid ||
             (hasUserProfile() && data.companyId == currentUser().companyId);
    }

    function isBillingMarkUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['billed', 'billNo', 'invoiceId', 'status', 'statusUpdatedAt']) &&
             request.resource.data.billed == true &&
             request.resource.data.status == 'Billed';
    }

    // Legacy helper retained for existing rule references.
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // User Profiles
    match /users/{userId} {
      // Public list is kept only for pre-auth duplicate and forgot-password checks.
      allow list: if !isAuthenticated() || isSuperAdmin();
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if true; 
      allow update: if isSuperAdmin() || (isActiveTransporter() && request.auth.uid == userId);
      allow delete: if false;
    }

    // Parties (Clients)
    match /parties/{partyId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow update, delete: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
    }

    // Trips (Shipment Logs)
    match /trips/{tripId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
      allow update: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
      allow delete: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
    }

    // Invoices (Permanent Tax Records)
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
      allow update: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
      allow delete: if false;
    }

    // Sequential Counters (LR and Bill Tracking)
    match /counters/{userId} {
      allow read, write: if isSuperAdmin() || (
        isActiveTransporter() &&
        (request.auth.uid == userId || (hasUserProfile() && currentUser().companyId == userId))
      );
    }
    
    match /billCounters/{userId} {
      allow read, write: if isSuperAdmin() || (
        isActiveTransporter() &&
        (request.auth.uid == userId || (hasUserProfile() && currentUser().companyId == userId))
      );
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow update, delete: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
    }

    // Drivers
    match /drivers/{driverId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow update, delete: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
    }

    // Trip Files (POD and related documents)
    match /tripFiles/{fileId} {
      allow read: if isSuperAdmin() || (hasUserProfile() && ownsCompany(resource.data));
      allow create: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(request.resource.data));
      allow update, delete: if isSuperAdmin() || (isActiveTransporter() && ownsCompany(resource.data));
    }

    // Default Deny for all unknown collections
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
